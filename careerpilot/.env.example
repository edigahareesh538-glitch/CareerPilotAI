# CareerPilot AI – example environment variables
# Copy to .env and fill in real values

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Backend ----------
APP_NAME=CareerPilot AI
ENV=development
DEBUG=true

SECRET_KEY=super-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/careerpilot
REDIS_URL=redis://localhost:6379/0

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=careerpilot
STORAGE_REGION=us-east-1
STORAGE_SECURE=false

# NVIDIA AI (optional)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=

# Local fallback models (Ollama, Whisper.cpp, Piper)
OLLAMA_BASE_URL=http://localhost:11434

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Rate limiting
RATE_LIMIT_DEFAULT=100/minute